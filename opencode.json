{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "pnpm french*": "allow",
      "pnpm speak*": "allow",
      "pnpm test*": "allow",
      "pnpm typecheck*": "allow",
      "pnpm install*": "allow",
      "pnpm exec vitest*": "allow",
      "pnpm exec tsc*": "allow",
      "pnpm exec tsx*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow",
      "*learning.db*": "deny",
      "rm *data*": "deny",
      "mv *data*": "deny",
      "rm *data/audio*": "allow",
      "rm *data/voices*": "allow",
      "mv *data/audio*": "allow",
      "mv *data/voices*": "allow"
    },
    "read": "allow",
    "edit": "ask"
  }
}
